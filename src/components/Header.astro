---
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL || '/';
const logoSrc = base === '/' ? '/RayView_transparent.svg' : `${base}/RayView_transparent.svg`;
const homeHref = base === '/' ? '/' : `${base}/`;
---

<header style={`height: var(--header-height); position: sticky; top: 0; z-index: 100; background: color-mix(in srgb, var(--color-bg) 80%, transparent); backdrop-filter: blur(12px); display: flex; align-items: center; justify-content: space-between; padding-left: var(--padding-x); padding-right: var(--padding-x);`}>
  <div style="display: flex; align-items: center;">
    <a href={homeHref} style="display: flex; align-items: center;">
      <img class="logo" src={logoSrc} alt="睿见 RayView" style="height: 32px;" />
    </a>
    <span id="clock" style="font-size: var(--text-xs); font-family: 'Geist Mono Variable', ui-monospace, 'SF Mono', Menlo, monospace; color: var(--color-text-primary); margin-left: var(--space-2); font-feature-settings: 'calt'; font-weight: 700;"></span>
  </div>

  <div id="search-container" style="display: flex; align-items: center; gap: var(--space-3);">
    <div id="search-wrapper" style="position: relative;">
      <input
        type="text"
        id="search-input"
        placeholder="搜索"
        style="width: 0; padding: var(--space-2) 0; border: none; border-bottom: 1px solid var(--color-border); background: transparent; color: var(--color-text-primary); font-size: var(--text-sm); outline: none; transition: width 200ms ease-out, padding 200ms ease-out, opacity 200ms ease-out; opacity: 0;"
      />
      <div id="search-results" style="position: absolute; top: 100%; right: 0; width: 280px; max-height: 300px; overflow-y: auto; background: var(--color-surface); border: 1px solid var(--color-border); display: none; z-index: 200;"></div>
    </div>

    <button id="search-toggle" aria-label="搜索" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border: none; background: none; cursor: pointer; color: var(--color-text-secondary);">
      <Icon id="search-icon" name="search" size={18} />
      <Icon id="close-icon" name="close" size={18} hidden />
    </button>

    <button id="theme-toggle" aria-label="Toggle theme" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border: none; background: none; cursor: pointer; color: var(--color-text-secondary); transition: transform var(--transition-slow);">
      <Icon id="sun-icon" name="light_mode" size={18} hidden />
      <Icon id="moon-icon" name="dark_mode" size={18} />
      <Icon id="system-icon" name="desktop_windows" size={18} hidden />
    </button>
  </div>
</header>

<script>
  const base = document.querySelector('html').dataset.base || '';

  function getSystemTheme(): string {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: string) {
    const actualTheme = theme === 'system' ? getSystemTheme() : theme;
    document.documentElement.dataset.theme = actualTheme;
  }

  const toggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  const systemIcon = document.getElementById('system-icon');

  function updateIcon(theme: string) {
    sunIcon.style.display = theme === 'light' ? 'block' : 'none';
    moonIcon.style.display = theme === 'dark' ? 'block' : 'none';
    systemIcon.style.display = theme === 'system' ? 'block' : 'none';
  }

  function setTheme(theme: string) {
    localStorage.setItem('theme', theme);
    applyTheme(theme);
    updateIcon(theme);
    toggle.style.transform = 'rotate(0deg)';
    void toggle.offsetWidth;
    toggle.style.transform = 'rotate(360deg)';
  }

  function cycleTheme() {
    const stored = localStorage.getItem('theme') || 'system';
    const current = stored === 'system' ? 'system' : document.documentElement.dataset.theme;
    const next = current === 'light' ? 'dark' : current === 'dark' ? 'system' : 'light';
    setTheme(next);
  }

  toggle.addEventListener('click', cycleTheme);

  const initialTheme = localStorage.getItem('theme') || 'system';
  applyTheme(initialTheme);
  updateIcon(initialTheme);

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (localStorage.getItem('theme') === 'system') {
      applyTheme('system');
    }
  });

  const searchToggle = document.getElementById('search-toggle');
  const searchIcon = document.getElementById('search-icon');
  const closeIcon = document.getElementById('close-icon');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results');
  let searchOpen = false;

  let searchData: Array<{title: string; url: string; tags: string[]; date: string}> = [];

  async function loadSearchIndex() {
    if (searchData.length === 0) {
      const res = await fetch(base === '/' ? '/search.json' : `${base}/search.json`);
      searchData = await res.json();
    }
  }

  function openSearch() {
    searchOpen = true;
    searchInput.style.width = '180px';
    searchInput.style.padding = '8px 12px';
    searchInput.style.opacity = '1';
    searchIcon.style.display = 'none';
    closeIcon.style.display = 'block';
    searchInput.focus();
    loadSearchIndex();
    if (window.innerWidth < 640) {
      clock.style.display = 'none';
    }
  }

  function closeSearch() {
    searchOpen = false;
    searchInput.style.width = '0';
    searchInput.style.padding = '8px 0';
    searchInput.style.opacity = '0';
    searchInput.value = '';
    searchResults.style.display = 'none';
    searchResults.innerHTML = '';
    searchIcon.style.display = 'block';
    closeIcon.style.display = 'none';
    clock.style.display = '';
  }

  function search(query: string) {
    if (!query) {
      searchResults.style.display = 'none';
      return;
    }
    const q = query.toLowerCase();
    const results = searchData.filter(item =>
      item.title.toLowerCase().includes(q) ||
      item.tags.some(t => t.toLowerCase().includes(q)) ||
      item.date.includes(q)
    );
    if (results.length === 0) {
      searchResults.innerHTML = `<p style="padding: 12px; color: var(--color-text-secondary); font-size: 12px;">未找到与“${query}”相关的文章。</p>`;
    } else {
      searchResults.innerHTML = results.slice(0, 5).map(item => {
        // base 前缀只在非根路径时拼接，避免 base='/' 时拼出协议相对 URL（//posts/…）
        const href = base === '/' || base === '' ? item.url : `${base}${item.url}`;
        return `
        <a href="${href}" style="display: block; padding: 12px; text-decoration: none; border-bottom: 1px solid var(--color-border);">
          <div style="font-weight: 380; color: var(--color-text-primary); font-size: 14px;">${item.title}</div>
          <div style="font-size: 12px; color: var(--color-text-secondary); margin-top: 4px;">${item.date}</div>
        </a>
      `;
      }).join('');
    }
    searchResults.style.display = 'block';
  }

  searchToggle.addEventListener('click', () => {
    if (searchOpen) {
      closeSearch();
    } else {
      openSearch();
    }
  });

  let debounce: number;
  searchInput.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => search(searchInput.value), 150);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && !searchOpen && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape' && searchOpen) {
      closeSearch();
    }
  });

  document.addEventListener('click', (e) => {
    if (searchOpen && !document.getElementById('search-container').contains(e.target as Node)) {
      closeSearch();
    }
  });

  const clock = document.getElementById('clock');
  function updateClock() {
    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    const colon = now.getSeconds() % 2 === 0 ? ':' : ' ';
    clock.textContent = `${h}${colon}${m}`;
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>