---
/**
 * 语言切换按钮 + 下拉菜单（RAY-465）
 *
 * 位置：Header 里 `#search-toggle` 和 `#theme-toggle` 之间，图标与另两个按钮同尺寸（18px）。
 *
 * 组件只负责渲染 —— 「目标语言有没有这个页面」由路由层（src/i18n/routes.ts）判断后，
 * 通过 `links` 传进来；`available: false` 的那一项渲染成灰色、不可点击的
 * `[role="menuitem"][aria-disabled="true"]`（不是 <a>，所以真的点不动，也没有 href 可以跟随）。
 *
 * 菜单项顺序固定为英文在前、简体中文在后，只有文案随界面语言变化。
 * 菜单项共三态：正在浏览的语言（加粗，中英分别取 MiSans 600 / Roboto 700，见下方样式注释里的映射表）、
 * 可切换的语言（常规字重）、目标语言没有对应页面（灰色 + aria-disabled，不可点击）。
 *
 * 每一项都标了 `hreflang`（目标语言，给搜索引擎/读屏说明链接去哪）与 `lang`（标签文字自身的语言，
 * 也就是界面语言：中文界面写「英文」，那两个字是中文）—— 加粗的按语言分流靠的就是这个 `lang`。
 *
 * 键盘：按钮上 ↓/↑ 展开并把焦点送进菜单；菜单内 ↑/↓/Home/End 移动，Esc 关闭并退回按钮，
 * Tab 移出菜单时自动收起；点击菜单外部同样关闭。
 */
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n';
import type { LanguageLink } from '../i18n/routes';

interface Props {
  /** 当前界面语言（决定菜单项文案） */
  lang: Lang;
  /** 由路由层给出的菜单项，已按固定顺序排列 */
  links: LanguageLink[];
}

const { lang, links } = Astro.props;
const t = useTranslations(lang);
---

<div class="lang-switch" id="lang-switch">
  <button
    type="button"
    id="lang-toggle"
    class="lang-switch__button"
    aria-label={t('header.language')}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="lang-menu"
  >
    <Icon name="translate" size={18} />
  </button>

  <div class="lang-menu" id="lang-menu" role="menu" aria-labelledby="lang-toggle" hidden>
    {links.map((link) =>
      link.available ? (
        <a
          class:list={['lang-menu__item', link.current && 'lang-menu__item--current']}
          role="menuitem"
          href={link.href}
          hreflang={link.lang}
          lang={lang}
          aria-current={link.current ? 'true' : undefined}
        >
          {t(`header.lang.${link.lang}`)}
        </a>
      ) : (
        <span
          class="lang-menu__item lang-menu__item--disabled"
          role="menuitem"
          aria-disabled="true"
          tabindex="-1"
          lang={lang}
        >
          {t(`header.lang.${link.lang}`)}
        </span>
      )
    )}
  </div>
</div>

<style>
  .lang-switch {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* 与 #search-toggle / #theme-toggle 完全同尺寸同色
     （RAY-486：色阶跟顶栏时钟走 --color-text-primary，不再用 --color-text-secondary） */
  .lang-switch__button {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--color-text-primary);
  }

  /* 面板外观与 #search-results 下拉一致：surface 底 + 1px 描边，不做圆角与阴影 */
  .lang-menu {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    min-width: 100%;
    max-width: calc(100vw - var(--padding-x) * 2);
    padding: var(--space-1);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  /* display: flex 会盖掉 hidden 属性的 UA 默认值，这里显式兜回来 */
  .lang-menu[hidden] {
    display: none;
  }

  .lang-menu__item {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  a.lang-menu__item:hover,
  .lang-menu__item:focus-visible {
    background: color-mix(in srgb, var(--color-text-primary) 10%, var(--color-surface));
  }

  .lang-menu__item:focus-visible {
    outline: none;
  }

  /* 正在浏览的语言：加粗标记（RAY-465，Ray 在「对勾 / 加粗」里选了加粗，字重定 600）。
     两个字体分开取值 —— CSS 的 font-weight 一个数值会同时喂给字体栈里的每个字体，
     而 MiSans（中文）与 Roboto Flex（拉丁）的 wght 轴并不同步，同一个数值下笔画粗细并不相等。
     所以按标签文字的语言分流：中文标签走 MiSans，英文标签走 Roboto。

       中文标签（lang="zh"）  MiSans 600
       英文标签（lang="en"）  Roboto Flex 700   ← 与上面那支视觉等重

     ⚠️ 映射表（RAY-465 实测，勿凭手感改）：
         字号 14px、DPR 8，笔画粗细 = 墨点 min(横向连段, 纵向连段) 的中位数（单位 CSS px）
         括号内为「4 × 平均距离变换」的独立交叉核对值，两个口径结论一致。

         CSS font-weight   320     400     520     600     700     800
         MiSans           1.000   1.250   1.625   2.000   2.250   2.250*
         Roboto Flex      1.125   1.250   1.625   1.750   2.000   2.250
                          (1.277) (1.396) (1.681) (1.838) (2.035) (2.238)
         对照 MiSans 的距离变换口径：1.244   1.476   1.804   2.036   2.292   2.292*
         * MiSans VF 的 wght 上限就是 700，再往上会被夹住。

         这张表对上了 global.css 里既有的映射：MiSans 520 ↔ Roboto 600（实测同为 1.625）、
         MiSans 700 ↔ Roboto 800（实测同为 2.250）。MiSans 600 落在两者之间，
         线性内插对应 Roboto ≈690，取最近的 700 —— 两支的连段口径与距离变换口径都吻合到 0.001。
         同样注意 320 那一档：拉丁反而略重于中文，所以常规字重的菜单项不做补偿。 */
  .lang-menu__item--current {
    font-weight: 600;
  }

  .lang-menu__item--current[lang='en'] {
    font-weight: 700;
  }

  /* 目标语言没有这个页面：灰色 + 不可点击（是 <span>，没有 href，也没有点击行为） */
  .lang-menu__item--disabled {
    color: var(--color-text-secondary);
    cursor: default;
  }
</style>

<script>
  (() => {
    const root = document.getElementById('lang-switch');
    const toggle = document.getElementById('lang-toggle');
    const menu = document.getElementById('lang-menu');
    if (!root || !toggle || !menu) return;

    const items = Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]'));

    const isOpen = () => !menu.hidden;

    function open(focusIndex?: number) {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      if (typeof focusIndex === 'number') items[focusIndex]?.focus();
    }

    function close(refocus = false) {
      if (!isOpen()) return;
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (refocus) toggle.focus();
    }

    function moveFocus(from: number, step: number) {
      if (items.length === 0) return;
      const index = (from + step + items.length) % items.length;
      items[index].focus();
    }

    toggle.addEventListener('click', () => {
      if (isOpen()) close();
      else open();
    });

    toggle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      open(event.key === 'ArrowDown' ? 0 : items.length - 1);
    });

    menu.addEventListener('keydown', (event) => {
      const index = items.indexOf(document.activeElement as HTMLElement);
      switch (event.key) {
        case 'ArrowDown':
          event.preventDefault();
          moveFocus(index < 0 ? -1 : index, 1);
          break;
        case 'ArrowUp':
          event.preventDefault();
          moveFocus(index < 0 ? 0 : index, -1);
          break;
        case 'Home':
          event.preventDefault();
          items[0]?.focus();
          break;
        case 'End':
          event.preventDefault();
          items[items.length - 1]?.focus();
          break;
        default:
          break;
      }
    });

    // 点击菜单外部关闭
    document.addEventListener('click', (event) => {
      if (isOpen() && !root.contains(event.target as Node)) close();
    });

    // Esc 关闭并把焦点退回按钮
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });

    // Tab 把焦点移出这块区域时一并收起，避免留下一个悬空的面板
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) close();
    });
  })();
</script>
