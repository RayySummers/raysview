---
/**
 * 语言切换按钮 + 下拉菜单（RAY-465）
 *
 * 位置：Header 里 `#search-toggle` 和 `#theme-toggle` 之间，图标与另两个按钮同尺寸（18px）。
 *
 * 组件只负责渲染 —— 「目标语言有没有这个页面」由路由层（src/i18n/routes.ts）判断后，
 * 通过 `links` 传进来；`available: false` 的那一项渲染成灰色、不可点击的
 * `[role="menuitem"][aria-disabled="true"]`（不是 <a>，所以真的点不动，也没有 href 可以跟随）。
 *
 * 菜单项顺序固定为英文在前、简体中文在后，只有文案随界面语言变化。
 * 菜单项共三态：正在浏览的语言（加粗）、可切换的语言（常规字重）、
 * 目标语言没有对应页面（灰色 + aria-disabled，不可点击）。
 *
 * 键盘：按钮上 ↓/↑ 展开并把焦点送进菜单；菜单内 ↑/↓/Home/End 移动，Esc 关闭并退回按钮，
 * Tab 移出菜单时自动收起；点击菜单外部同样关闭。
 */
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n';
import type { LanguageLink } from '../i18n/routes';

interface Props {
  /** 当前界面语言（决定菜单项文案） */
  lang: Lang;
  /** 由路由层给出的菜单项，已按固定顺序排列 */
  links: LanguageLink[];
}

const { lang, links } = Astro.props;
const t = useTranslations(lang);
---

<div class="lang-switch" id="lang-switch">
  <button
    type="button"
    id="lang-toggle"
    class="lang-switch__button"
    aria-label={t('header.language')}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="lang-menu"
  >
    <Icon name="translate" size={18} />
  </button>

  <div class="lang-menu" id="lang-menu" role="menu" aria-labelledby="lang-toggle" hidden>
    {links.map((link) =>
      link.available ? (
        <a
          class:list={['lang-menu__item', link.current && 'lang-menu__item--current']}
          role="menuitem"
          href={link.href}
          hreflang={link.lang}
          lang={link.lang}
          aria-current={link.current ? 'true' : undefined}
        >
          {t(`header.lang.${link.lang}`)}
        </a>
      ) : (
        <span
          class="lang-menu__item lang-menu__item--disabled"
          role="menuitem"
          aria-disabled="true"
          tabindex="-1"
        >
          {t(`header.lang.${link.lang}`)}
        </span>
      )
    )}
  </div>
</div>

<style>
  .lang-switch {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* 与 #search-toggle / #theme-toggle 完全同尺寸同色 */
  .lang-switch__button {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    cursor: pointer;
    color: var(--color-text-secondary);
  }

  /* 面板外观与 #search-results 下拉一致：surface 底 + 1px 描边，不做圆角与阴影 */
  .lang-menu {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    min-width: 100%;
    max-width: calc(100vw - var(--padding-x) * 2);
    padding: var(--space-1);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  /* display: flex 会盖掉 hidden 属性的 UA 默认值，这里显式兜回来 */
  .lang-menu[hidden] {
    display: none;
  }

  .lang-menu__item {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  a.lang-menu__item:hover,
  .lang-menu__item:focus-visible {
    background: color-mix(in srgb, var(--color-text-primary) 10%, var(--color-surface));
  }

  .lang-menu__item:focus-visible {
    outline: none;
  }

  /* 正在浏览的语言：加粗标记（RAY-465，Ray 在「对勾 / 加粗」里选了加粗）。
     700 是这套设计里既有的强调档（中英同名等重：MiSans 700 ↔ Roboto 800），
     首页 nav-link hover、文章标题用的都是它；这里只加粗，不换色。 */
  .lang-menu__item--current {
    font-weight: 700;
  }

  /* 目标语言没有这个页面：灰色 + 不可点击（是 <span>，没有 href，也没有点击行为） */
  .lang-menu__item--disabled {
    color: var(--color-text-secondary);
    cursor: default;
  }
</style>

<script>
  (() => {
    const root = document.getElementById('lang-switch');
    const toggle = document.getElementById('lang-toggle');
    const menu = document.getElementById('lang-menu');
    if (!root || !toggle || !menu) return;

    const items = Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]'));

    const isOpen = () => !menu.hidden;

    function open(focusIndex?: number) {
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      if (typeof focusIndex === 'number') items[focusIndex]?.focus();
    }

    function close(refocus = false) {
      if (!isOpen()) return;
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (refocus) toggle.focus();
    }

    function moveFocus(from: number, step: number) {
      if (items.length === 0) return;
      const index = (from + step + items.length) % items.length;
      items[index].focus();
    }

    toggle.addEventListener('click', () => {
      if (isOpen()) close();
      else open();
    });

    toggle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      open(event.key === 'ArrowDown' ? 0 : items.length - 1);
    });

    menu.addEventListener('keydown', (event) => {
      const index = items.indexOf(document.activeElement as HTMLElement);
      switch (event.key) {
        case 'ArrowDown':
          event.preventDefault();
          moveFocus(index < 0 ? -1 : index, 1);
          break;
        case 'ArrowUp':
          event.preventDefault();
          moveFocus(index < 0 ? 0 : index, -1);
          break;
        case 'Home':
          event.preventDefault();
          items[0]?.focus();
          break;
        case 'End':
          event.preventDefault();
          items[items.length - 1]?.focus();
          break;
        default:
          break;
      }
    });

    // 点击菜单外部关闭
    document.addEventListener('click', (event) => {
      if (isOpen() && !root.contains(event.target as Node)) close();
    });

    // Esc 关闭并把焦点退回按钮
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });

    // Tab 把焦点移出这块区域时一并收起，避免留下一个悬空的面板
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) close();
    });
  })();
</script>
