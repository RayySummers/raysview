---
/**
 * 「关于」页（RAY-465：中英共用同一份模板）
 *
 * 文案（含链接）在 src/i18n/about.ts；这里只管排版。
 */
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import ProseInlines from '../ProseInlines.astro';
import { langFromPath, useTranslations } from '../../i18n';
import { ABOUT } from '../../i18n/about';
import { hrefFor } from '../../i18n/routes';

const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const copy = ABOUT[lang];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rayy Summers',
  alternateName: 'Ray',
  url: 'https://raysview.fun/about/',
  description: copy.metaDescription,
  sameAs: [
    'https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=MzYzNTI3NjQwMg==#wechat_redirect',
    'https://www.zhihu.com/people/hunderlineh',
    'https://github.com/RayySummers',
    'https://bsky.app/profile/rayysummers.bsky.social',
    'https://x.com/xRayySummers'
  ]
};

const body = 'font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);';
const heading2 = 'font-size: var(--text-lg); font-weight: 520; color: var(--color-text-primary); margin-top: var(--space-5);';
---

<Base title={copy.title} description={copy.metaDescription} ogType="profile" structuredData={personLd} page="about">
  <a href={hrefFor('/', lang)} style="display: inline-block; color: var(--color-text-secondary); transition: color var(--transition-fast);" aria-label={copy.backLabel} class="back-btn">
    <Icon name="arrow_back" size={20} />
  </a>

  <h2 style="font-size: var(--text-lg); font-weight: 520; color: var(--color-text-primary); margin-top: var(--space-4);">{copy.heading}</h2>
  {copy.intro.map(paragraph => (
    <p style={body}>
      <ProseInlines segments={paragraph} />
    </p>
  ))}

  <h3 style="font-size: var(--text-base); font-weight: 520; color: var(--color-text-primary); margin-top: var(--space-4);">{copy.platformsHeading}</h3>
  <ul style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3); padding-left: 1.25em;">
    {copy.platforms.map(platform => (
      <li>
        {platform.name}{copy.platformSeparator}<a href={platform.href} target="_blank" rel="noopener" style="color: var(--color-text-primary);">{platform.handle}</a>
      </li>
    ))}
  </ul>

  <h2 style={heading2}>{copy.historyHeading}</h2>
  {copy.history.map(paragraph => (
    <p style={body}>
      <ProseInlines segments={paragraph} />
    </p>
  ))}

  <h2 style={heading2}>{copy.siteHeading}</h2>
  {copy.site.map(paragraph => (
    <p style={body}>
      <ProseInlines segments={paragraph} />
    </p>
  ))}
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-secondary); margin-top: var(--space-3);">
    <ProseInlines segments={copy.fontNotice} muted />
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-secondary); margin-top: var(--space-3);">
    <ProseInlines segments={copy.icpNotice} muted />
  </p>

  <p style="margin-top: var(--space-6);">■</p>

  <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-4);">
    {copy.updated}
  </p>
</Base>

<style>
  .back-btn:hover {
    color: var(--color-text-primary) !important;
  }
</style>
