---
/**
 * 标签归档页（RAY-465：中英共用同一份模板）
 *
 * noindex：tag 归档页内容与文章页重复，主动不索引（保留 canonical 供去重/引用）。
 * 若未来有意做 tag 流量，去掉 noindex 即可。
 *
 * RAY-545：列表标题同样去掉「 | 系列名 #NN」后缀（与 /posts、系列页、文章页 h1 一致）。
 */
import Base from '../../layouts/Base.astro';
import { langFromPath, useTranslations } from '../../i18n';
import { hrefFor } from '../../i18n/routes';
import { displayPostTitle } from '../../series';

interface Props {
  tag: string;
  posts: { id: string; data: { title: string; date: Date } }[];
}

const { tag, posts } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<Base title={t('tags.title', { tag })} noindex>
  <h1 style="font-size: var(--text-xs); color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-6);">{t('tags.heading', { tag })}</h1>

  <div>
    {posts.map((post) => (
      <article style="margin-bottom: var(--space-3);">
        <a href={hrefFor(`/posts/${post.id}/`, lang)} class="post-title-link">
          <h3 class="post-title">
            {displayPostTitle(post.data.title)}
          </h3>
        </a>
        <div style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-1);">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().split('T')[0]}</time>
        </div>
      </article>
    ))}
  </div>

  <a href={hrefFor('/', lang)} style="display: inline-block; margin-top: var(--space-6); font-size: var(--text-sm); color: var(--color-text-secondary);">{t('tags.back')}</a>
</Base>

<style>
  /* RAY-525：文章标题 hover = 变粗（320 → 620、100ms）＋ 下划线出现（transparent → currentColor），
     与 PostListPage / SeriesPage 同款，参数对齐 .nav-link（PostListPage 顶部系列链接）。
     RAY-527：变粗档由 700 降到 620（＝静止 320 ＋ 300，约 SemiBold 观感）。 */
  .post-title-link {
    display: block;
    text-decoration: none;
  }
  .post-title {
    width: fit-content;
    font-size: var(--text-base);
    font-weight: 320;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      text-decoration-color var(--transition-fast),
      font-weight 100ms ease-out;
  }
  .post-title:hover {
    font-weight: 620; /* RAY-527：320 → 620（+300 档），与 .nav-link 同档 */
    text-decoration-color: currentColor;
  }
</style>
