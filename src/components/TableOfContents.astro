---
import Icon from './Icon.astro';
import { langFromPath, useTranslations } from '../i18n';

interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth >= 1 && h.depth <= 3);

// 语言从 URL 推导，与 Base / 页面组件同源（RAY-465）
const t = useTranslations(langFromPath(Astro.url.pathname));
---

{filteredHeadings.length > 0 && (
  <div class="toc-container">
    {/* aria-controls 指向浮层；aria-expanded 由脚本随开关状态维护（RAY-632） */}
    <button id="toc-toggle" class="toc-btn" aria-label={t('toc.label')} aria-expanded="false" aria-controls="toc-panel">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
    {/* 导航语义放在浮层根节点上：屏幕阅读器读作「目录 导航区」（RAY-632） */}
    <div id="toc-panel" class="toc-panel" role="navigation" aria-label={t('toc.label')} hidden>
      <div class="toc-header">
        <span>{t('toc.label')}</span>
        <button id="toc-close" class="toc-close" aria-label={t('toc.close')}>
          <Icon name="close" size={16} />
        </button>
      </div>
      <div class="toc-nav">
        {filteredHeadings.map(h => (
          <a
            href={`#${h.slug}`}
            class={`toc-item depth-${h.depth}`}
            data-toc-target={h.slug}
          >
            {h.text}
          </a>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .toc-container {
    position: fixed;
    bottom: var(--space-5);
    right: var(--space-5);
    z-index: 100;
  }

  .toc-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }

  .toc-btn:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  .toc-panel {
    position: absolute;
    bottom: 60px;
    right: 0;
    width: 280px;
    max-height: 400px;
    overflow-y: auto;
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    animation: slideUp 0.2s ease-out;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .toc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-sm);
    font-weight: 520;
  }

  .toc-close {
    background: none;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: var(--space-1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition-fast);
  }

  .toc-close:hover {
    color: var(--color-text-primary);
  }

  .toc-nav {
    padding: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .toc-item {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    line-height: 1.4;
  }

  .toc-item:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  /* 当前章节（RAY-632）：不只靠颜色区分——字重 + 左侧竖线一起标 */
  .toc-item.is-active {
    color: var(--color-text-primary);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--color-text-primary);
  }

  /* 减少动效偏好：高亮不过渡，直接切换（RAY-632） */
  @media (prefers-reduced-motion: reduce) {
    .toc-item {
      transition: none;
    }
  }

  .toc-item.depth-3 {
    padding-left: calc(var(--space-3) + var(--space-4));
    font-size: var(--text-xs);
  }

  .toc-item.depth-2 {
    padding-left: var(--space-4);
  }

  /* ===== 桌面常驻侧栏（RAY-633）=====
     同一套 DOM、同一份 <nav>：这里只把浮层容器从 fixed 改成 sticky 侧栏，收起开关按钮，
     让目录本体直接展开。窄屏规则一条没动，也不存在「两份目录」。 */
  @media (min-width: 1200px) {
    .toc-container {
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
      right: auto;
      bottom: auto;
      z-index: 1;
      display: flex;
      flex-direction: column;
      /* 视口矮时封顶；超高只让目录本体滚动，正文照常滚动不受牵连 */
      max-height: calc(100vh - var(--header-height) - var(--space-4) - var(--space-6));
      min-height: 0;
    }

    .toc-btn {
      display: none;
    }

    /* 桌面形态不依赖脚本：即使 JS 没跑，目录也以侧栏出现（脚本只负责同步 hidden，
       让辅助技术也读到这个 nav）。 */
    .toc-panel {
      display: block; /* 覆盖 [hidden] 的用户代理样式 display:none */
      position: static;
      width: auto;
      max-height: none;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border: none;
      border-radius: 0;
      box-shadow: none;
      animation: none;
    }

    .toc-header {
      position: sticky;
      top: 0;
      z-index: 1;
      padding: 0 0 var(--space-2);
      border-bottom: none;
      background: var(--color-bg);
      font-size: var(--text-xs);
      letter-spacing: 0.08em;
      color: var(--color-text-secondary);
    }

    .toc-close {
      display: none;
    }

    .toc-nav {
      padding: 0;
      gap: 0;
      border-left: 1px solid var(--color-border);
    }

    .toc-item {
      padding: var(--space-1) var(--space-3);
      margin-left: -1px; /* 压在竖线上：active 的 2px 才与线重合，不产生 1px 错位 */
      border-left: 2px solid transparent;
      border-radius: 0;
      line-height: 1.45;
    }

    .toc-item:hover {
      background: none;
      color: var(--color-text-primary);
    }

    .toc-item.is-active {
      /* 侧栏里用 2px 竖线代替浮层的 inset 阴影，视觉上贴着目录导轨 */
      box-shadow: none;
      border-left-color: var(--color-text-primary);
      background: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('toc-toggle');
  const panel = document.getElementById('toc-panel');
  const close = document.getElementById('toc-close');

  // RAY-633：≥1200px 时目录是常驻侧栏，不再是「点开才出现」的浮层。
  // 断点值必须和 <style> 里的 @media (min-width: 1200px) 保持一致。
  const wideQuery = window.matchMedia('(min-width: 1200px)');
  const isWide = () => wideQuery.matches;

  // 开关收敛成两个函数：aria-expanded 必须和 hidden 同步（RAY-632）
  function openPanel() {
    if (!panel || !toggle) return;
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    // 焦点移入面板第一项；preventScroll 避免元素聚焦把页面拽走（RAY-632）
    (panel.querySelector<HTMLElement>('.toc-item'))?.focus({ preventScroll: true });
  }

  function closePanel(refocusToggle: boolean) {
    if (!panel || !toggle) return;
    if (panel.hidden) return;
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    if (refocusToggle) toggle.focus();
  }

  // 断点形态同步：宽屏把面板从「隐藏的浮层」改成「展开的侧栏」。
  // hidden 是给辅助技术的开关（CSS 在宽屏也会强制显示，脚本没跑起来时侧栏照样在）。
  function applyMode() {
    if (!panel || !toggle) return;
    if (isWide()) {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    } else {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      panel.scrollTop = 0;
    }
  }
  applyMode();

  toggle?.addEventListener('click', () => {
    if (panel) {
      if (panel.hidden) openPanel(); else closePanel(false);
    }
  });

  close?.addEventListener('click', () => closePanel(true));

  // Esc 关闭浮层并把焦点还给触发按钮（RAY-632）
  document.addEventListener('keydown', (e) => {
    // 侧栏常驻形态下没有「关闭」语义：Esc 不能把目录关掉（RAY-633）
    if (isWide()) return;
    if (e.key === 'Escape' && panel && !panel.hidden) {
      closePanel(true);
    }
  });

  // Close on outside click（焦点不动，留在用户点击的位置）
  document.addEventListener('click', (e) => {
    // 侧栏形态同理：点正文不算「点外面」，否则滚一下就把目录点没了（RAY-633）
    if (isWide()) return;
    const container = document.querySelector('.toc-container');
    if (container && !container.contains(e.target as Node) && panel && !panel.hidden) {
      closePanel(false);
    }
  });

// Smooth scroll for ToC links
  document.querySelectorAll('.toc-item').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (link as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          const NAVBAR_HEIGHT = 48;
          const targetPosition = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - NAVBAR_HEIGHT;
          if ((window as any).lenis) {
            (window as any).lenis.scrollTo(targetPosition, { offset: 0 });
          } else {
            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
          }
          history.pushState(null, '', href);
        }
      }
    });
  });

  // ===== 滚动高亮 scrollspy（RAY-632）：IntersectionObserver，无第三方依赖 =====
  // 结构说明：rootMargin 顶部收掉 48px（导航高度，与上面的点击滚动偏移一致）、
  // 底部收成一条 0 高的分隔线。标题穿过这条线才记为「当前章节」：
  // 刚滚到某节开头（标题还在导航条下方）不会被误判成下一节；
  // 标题离开分隔线后不清空高亮，因此滚到文末最后一节保持点亮。
  if (panel) {
    const links = Array.from(panel.querySelectorAll<HTMLAnchorElement>('.toc-item'));
    const ACTIVE_OFFSET = 48; // 与点击滚动的 NAVBAR_HEIGHT 同源，勿单独改
    let activeId = '';

    const setActive = (id: string) => {
      if (!id || id === activeId) return;
      activeId = id;
      links.forEach((link) => {
        const isOn = link.dataset.tocTarget === id;
        link.classList.toggle('is-active', isOn);
        if (isOn) {
          link.setAttribute('aria-current', 'true');
          // 侧栏目录自身可滚动：高亮项被滚出可视区时把它带回来（RAY-633）
          if (isWide() && panel.scrollHeight > panel.clientHeight + 1) {
            const box = panel.getBoundingClientRect();
            const item = link.getBoundingClientRect();
            const topMargin = 32; // 让开 sticky 的「目录」标题
            if (item.top < box.top + topMargin) {
              panel.scrollTop -= box.top + topMargin - item.top;
            } else if (item.bottom > box.bottom - 8) {
              panel.scrollTop += item.bottom - (box.bottom - 8);
            }
          }
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const headingEls = links
      .map((link) => document.getElementById(link.dataset.tocTarget || ''))
      .filter((el): el is HTMLElement => !!el);

    if (headingEls.length > 0) {
      // 按实际位置校对一次：取最后一个已越过分隔线的标题。
      // 连续滚动由 IO 负责瞬时切换；这里是兜底——直接跳到底部、拖动滚动条、
      // 点目录项这类「没有穿越过程」的移动，IO 不会回调，靠它补上（RAY-632）
      let reconcileTimer = 0;
      const reconcile = () => {
        // +1px 容差：点目录项后标题正好停在 48px 线上，避免浮点误差判成「还没到」
        const passed = headingEls.filter((el) => el.getBoundingClientRect().top <= ACTIVE_OFFSET + 1);
        if (passed.length > 0) {
          setActive(passed[passed.length - 1].id);
        }
      };

      // 停稳后再算，避免和 IO 的回调互相抢（150ms ≈ 一次平滑滚动的收尾）
      window.addEventListener('scroll', () => {
        clearTimeout(reconcileTimer);
        reconcileTimer = window.setTimeout(reconcile, 150);
      }, { passive: true });

      // 首屏就位：带 hash 打开或刷新回到文章中部时先算一次
      reconcile();

      const spy = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          // 只在「穿过分隔线」这一态点亮；离开线（向下滚）自然由下一节接管
          if (entry.isIntersecting) {
            setActive(entry.target.id);
          }
        }
      }, { rootMargin: `-${ACTIVE_OFFSET}px 0px -100% 0px` });

      headingEls.forEach((el) => spy.observe(el));

      // 断点切换：同步 hidden / aria-expanded，并在进入侧栏形态后按当前滚动位置补算高亮
      wideQuery.addEventListener('change', () => {
        applyMode();
        if (isWide()) requestAnimationFrame(reconcile);
      });
    }
  }

  // Footnote back-links with offset (avoid navbar)
  document.querySelectorAll('a[data-footnote-backref]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (link as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        if (target) {
          const NAVBAR_HEIGHT = 48;
          const targetPosition = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - NAVBAR_HEIGHT;
          if ((window as any).lenis) {
            (window as any).lenis.scrollTo(targetPosition, { offset: 0, duration: 1.2 });
          } else {
            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
          }
          history.pushState(null, '', href);
        }
      }
    });
  });

  // Regular footnote links (not back-links)
  document.querySelectorAll('.footnotes a[href^="#fnref"]:not([data-footnote-backref])').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const href = (link as HTMLAnchorElement).getAttribute('href');
      if (href) {
        const targetId = href.replace('#', '');
        const target = document.getElementById(targetId) || document.querySelector(`[id="${targetId}"]`);
        if (target) {
          const NAVBAR_HEIGHT = 48;
          const targetPosition = (target as HTMLElement).getBoundingClientRect().top + window.scrollY - NAVBAR_HEIGHT;
          if ((window as any).lenis) {
            (window as any).lenis.scrollTo(targetPosition, { offset: 0, duration: 1.2 });
          } else {
            window.scrollTo({ top: targetPosition, behavior: 'smooth' });
          }
          history.pushState(null, '', href);
        }
      }
    });
  });
</script>