---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="敬请期待 - RayView">
  <a href={`${base}/`} style="display: inline-block; color: var(--color-text-secondary); transition: color var(--transition-fast);" aria-label="Back" class="back-btn">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </a>
  <p style="font-size: var(--text-3xl); font-weight: 700; color: var(--color-text-primary); text-align: center; padding: var(--space-6) 0 0 0;">敬请期待</p>
</Base>

<style>
  .back-btn:hover {
    color: var(--color-text-primary);
  }
</style>