---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL || '/';
---

<Base title="404 - Page Not Found" noindex>
  <div style="text-align: center; padding: var(--space-8) 0;">
    <h1 style="font-size: 120px; font-weight: 800; line-height: 1; margin-bottom: var(--space-4);">404</h1>
    <p style="font-size: var(--text-xl); color: var(--color-text-secondary); margin-bottom: var(--space-6);">
      页面不存在
    </p>
    <a href={base === '/' ? '/' : `${base}/`} style="font-size: var(--text-sm); color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 3px;">
      ← 返回首页
    </a>
  </div>
</Base>
