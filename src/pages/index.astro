---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL || '/';
const getHref = (path: string) => base === '/' ? path : `${base}${path}`;
const description = '睿见 RayView 是 Rayy Summers 的个人博客，分享设计、语言学、AI、社会现象与日常观察。';
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '睿见 RayView',
  alternateName: 'RayView',
  url: 'https://raysview.fun',
  description,
  inLanguage: 'zh-CN'
};
---

<Base
  title="睿见 RayView | Ray 的个人博客"
  description={description}
  structuredData={websiteLd}
>
  <p style="font-size: var(--text-xl); font-weight: 630; color: var(--color-text-primary); margin-bottom: var(--space-2);">Hello, I'm Ray</p>
  <p style="font-size: var(--text-base); color: var(--color-text-secondary); margin-bottom: var(--space-6);">
    This is 睿见 RayView — 分享设计、语言学、AI、社会现象与日常观察。
  </p>

  <nav style="display: flex; flex-direction: column; gap: var(--space-3);">
    <a href={getHref('/posts/')} class="nav-link" style="font-size: var(--text-xl); color: var(--color-text-primary); text-decoration: none;">
      文章 Posts
    </a>
    <a href={getHref('/videos/')} class="nav-link" style="font-size: var(--text-xl); color: var(--color-text-primary); text-decoration: none;">
      视频 Videos
    </a>
    <a href={getHref('/about/')} class="nav-link" style="font-size: var(--text-xl); color: var(--color-text-primary); text-decoration: none;">
      关于 About
    </a>
  </nav>
</Base>

<style>
  /* RAY-408 精确映射 + RAY-412 校正：首页 3 tab rest 350→320 Regular（400↔320，330→320 微调实现 CJK 与 Roboto 400 视觉等重），hover 800→700 Heavy（800↔700，中英文同名等重） */
  .nav-link {
    position: relative;
    display: inline-block;
    width: fit-content;
    font-weight: 320;
    transition: font-weight 100ms ease-out;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-text-primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms ease-out;
  }
  .nav-link:hover {
    font-weight: 700;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link:not(:hover)::after {
    transform: scaleX(0);
  }
</style>