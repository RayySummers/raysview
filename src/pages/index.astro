---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="RayView">
  <p style="font-size: var(--text-xl); font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-6);">Hello, I'm Ray</p>

  <nav style="display: flex; flex-direction: column; gap: var(--space-3);">
    <a href={`${base}/posts/`} class="nav-link" style="font-size: var(--text-xl); color: var(--color-text-primary); text-decoration: none;">
      文章 Posts
    </a>
    <a href={`${base}/videos/`} class="nav-link" style="font-size: var(--text-xl); color: var(--color-text-primary); text-decoration: none;">
      视频 Videos
    </a>
    <a href={`${base}/about/`} class="nav-link" style="font-size: var(--text-xl); color: var(--color-text-primary); text-decoration: none;">
      关于 About
    </a>
  </nav>
</Base>

<style>
  .nav-link {
    position: relative;
    display: inline-block;
    width: fit-content;
    font-weight: 400;
    transition: font-weight 100ms ease-out;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-text-primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms ease-out;
  }
  .nav-link:hover {
    font-weight: 800;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link:not(:hover)::after {
    transform: scaleX(0);
  }
</style>