---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL || '/';
const description = 'Rayy Summers（Ray）的个人介绍：语言学专业学生，公众号「睿见 RayView」主理人，分享设计、语言学、AI、社会现象与日常观察。';
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rayy Summers',
  alternateName: 'Ray',
  url: 'https://raysview.fun/about/',
  description,
  sameAs: [
    'https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=MzYzNTI3NjQwMg==#wechat_redirect',
    'https://www.zhihu.com/people/hunderlineh',
    'https://github.com/RayySummers',
    'https://bsky.app/profile/rayysummers.bsky.social'
  ]
};
---

<Base title="关于 - 睿见 RayView" description={description} ogType="profile" structuredData={personLd}>
  <a href={base === '/' ? '/' : `${base}/`} style="display: inline-block; color: var(--color-text-secondary); transition: color var(--transition-fast);" aria-label="Back" class="back-btn">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </a>

  <h2 style="font-size: var(--text-lg); font-weight: 600; color: var(--color-text-primary); margin-top: var(--space-4);">关于 Ray</h2>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    我是 Rayy Summers，您可以叫我 Ray。我来自重庆，目前住在广州。目前就读于广东外语外贸大学英语语言学拔尖人才实验班。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    目前运营微信公众号 @睿见 RayView (@RayView365)，主要发布《半月记（Biweekly）》记录每半个月的洞察和思考、《Ray 的设计课（RayDesign）》分享我对设计的见解。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    如有需要，您可以通过电子邮件（<code>rayysummers[at]proton.me</code>）联系我。
  </p>

  <h3 style="font-size: var(--text-base); font-weight: 600; color: var(--color-text-primary); margin-top: var(--space-4);">其他平台</h3>
  <ul style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3); padding-left: 1.25em;">
    <li>微信公众号：<a href="https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=MzYzNTI3NjQwMg==#wechat_redirect" target="_blank" rel="noopener" style="color: var(--color-text-primary);">@RayView365</a></li>
    <li>知乎：<a href="https://www.zhihu.com/people/hunderlineh" target="_blank" rel="noopener" style="color: var(--color-text-primary);">@睿见RayView</a></li>
    <li>GitHub：<a href="https://github.com/RayySummers" target="_blank" rel="noopener" style="color: var(--color-text-primary);">@RayySummers</a></li>
    <li>Bluesky：<a href="https://bsky.app/profile/rayysummers.bsky.social" target="_blank" rel="noopener" style="color: var(--color-text-primary);">@rayysummers.bsky.social</a></li>
  </ul>

  <h2 style="font-size: var(--text-lg); font-weight: 600; color: var(--color-text-primary); margin-top: var(--space-5);">关于睿见 RayView</h2>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    睿见 RayView 是 Ray 的个人博客，目前在微信公众号和本网站活跃。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2025 年 10 月 20 日，我在个人朋友圈发布了我的第 1 期周记。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2025 年 11 月 23 日，我创建了微信公众号 @睿见RayView，并发布了第 6 周周记。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2025 年 12 月 22 日，发布第 10 周周记。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2026 年 1 月 16 日，《周记（Weekly）》系列停止更新，发布《半月记（Biweekly）》第 1 期。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2026 年 4 月 25 日，发布第一期《Ray 的设计课（RayDesign）》。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2026 年 5 月 21 日，博客网站正式公开，部署在 GitHub Pages。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2026 年 7 月 1 日，博客网站备案通过，部署到腾讯云服务器。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    2026 年 7 月 10 日，发布第一期《随便想想（JustThinking）》。
  </p>

  <h2 style="font-size: var(--text-lg); font-weight: 600; color: var(--color-text-primary); margin-top: var(--space-5);">关于这个网站</h2>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    这个网站基于 Astro 构建，部署在腾讯云服务器，域名 raysview.fun。整个网站都由 OpenCode 帮助搭建。
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-primary); margin-top: var(--space-3);">
    GitHub 仓库：<a href="https://github.com/RayySummers/raysview" target="_blank" rel="noopener" style="color: var(--color-text-primary);">github.com/RayySummers/raysview</a>
  </p>
  <p style="font-size: var(--text-xs); line-height: 1.8; color: var(--color-text-secondary); margin-top: var(--space-3);">
    中文字体使用 <a href="https://hyperos.mi.com/font" target="_blank" rel="noopener" style="color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 2px;">MiSans © Xiaomi</a>（自托管 VF，许可见<a href="https://hyperos.mi.com/font-download/MiSans%E5%AD%97%E4%BD%93%E7%9F%A5%E8%AF%86%E4%BA%A7%E6%9D%83%E8%AE%B8%E5%8F%AF%E5%8D%8F%E8%AE%AE.pdf" target="_blank" rel="noopener" style="color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 2px;">知识产权许可协议</a>，本站仅嵌入 woff2 子集用于正文展示）
  </p>
  <p style="font-size: var(--text-base); line-height: 1.8; color: var(--color-text-secondary); margin-top: var(--space-3);">
    备案号：渝 ICP 备 2026010610 号
  </p>

  <p style="margin-top: var(--space-6);">■</p>

  <p style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-4);">
    最近更新：2026-08-13
  </p>
</Base>

<style>
  .back-btn:hover {
    color: var(--color-text-primary) !important;
  }
</style>
