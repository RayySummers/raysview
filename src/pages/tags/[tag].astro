---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const siteBase = import.meta.env.BASE_URL;
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap(post => post.data.tags || []))];
  return tags.map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter(p => p.data.tags?.includes(tag)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      siteBase
    }
  }));
}

const { tag, posts, siteBase } = Astro.props as { tag: string; posts: any[]; siteBase: string };
// base 为 '/'（站点根部署）时不再拼接前缀，避免拼出协议相对 URL（//posts/…）
const getHref = (path: string) => siteBase === '/' || siteBase === '' ? path : `${siteBase}${path}`;
// noindex：tag 归档页内容与文章页重复，主动不索引（保留 canonical 供去重/引用）。
// 若未来有意做 tag 流量，去掉 noindex 即可。
---

<Base title={`${tag} - 睿见 RayView`} noindex>
  <h1 style="font-size: var(--text-xs); color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-6);">标签: {tag}</h1>

  <div>
    {posts.map((post) => (
      <article style="margin-bottom: var(--space-3);">
        <a href={getHref(`/posts/${post.id}`)} style="display: block; text-decoration: none;">
          <h3 style="font-size: var(--text-base); font-weight: 400; color: var(--color-text-primary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--transition-fast);">
            {post.data.title}
          </h3>
        </a>
        <div style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-1);">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().split('T')[0]}</time>
        </div>
      </article>
    ))}
  </div>

  <a href={`${siteBase}/`} style="display: inline-block; margin-top: var(--space-6); font-size: var(--text-sm); color: var(--color-text-secondary);">← Back</a>
</Base>