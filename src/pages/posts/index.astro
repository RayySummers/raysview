---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL || '/';
const getHref = (path: string) => base === '/' ? path : `${base}${path}`;
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const grouped = posts.reduce((acc, post) => {
  const date = post.data.date;
  const year = date.getFullYear();
  const month = date.getMonth() + 1;
  const key = `${year}年${month}月`;
  if (!acc[key]) acc[key] = [];
  acc[key].push(post);
  return acc;
}, {} as Record<string, typeof posts>);
---

<Base title="文章 - 睿见 RayView">
  <a href={getHref('/')} style="display: inline-block; color: var(--color-text-secondary); transition: color var(--transition-fast);" aria-label="Back" class="back-btn">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </a>

  <div style="display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4);">
    <a
      href={getHref('/posts/justthinking/')}
      class="nav-link"
    >
      <span style="font-size: var(--text-base); color: var(--color-text-primary);">
        随便想想 / JustThinking
      </span>
    </a>

    <a
      href={getHref('/posts/biweekly/')}
      class="nav-link"
    >
      <span style="font-size: var(--text-base); color: var(--color-text-primary);">
        半月记 / Biweekly
      </span>
    </a>

    <a
      href={getHref('/posts/raydesign/')}
      class="nav-link"
    >
      <span style="font-size: var(--text-base); color: var(--color-text-primary);">
        Ray 的设计课 / RayDesign
      </span>
    </a>
  </div>

  {Object.entries(grouped).map(([period, periodPosts]) => (
    <div style="margin-bottom: var(--space-6);">
      <h2 class="date-cjk" style="font-size: 11px; font-weight: 320; line-height: 1.3; color: var(--color-text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-3);">{period}</h2>
      <div>
        {periodPosts.map((post) => (
          <article style="margin-bottom: var(--space-3);">
            <a href={getHref(`/posts/${post.id}`)} style="display: block; text-decoration: none;">
              <h3 style="font-size: var(--text-base); font-weight: 320; color: var(--color-text-primary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--transition-fast);">
                {post.data.title}
              </h3>
            </a>
            <div style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-1);">
              <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().split('T')[0]}</time>
              {post.data.tags && post.data.tags.length > 0 && (
                <span style="margin-left: var(--space-2);">
                  {post.data.tags.map((tag, idx) => (
                    <>
                      {idx > 0 && ' '}
                      <a href={getHref(`/tags/${tag}`)} style="color: var(--color-text-secondary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--transition-fast);">
                        #{tag}
                      </a>
                    </>
                  ))}
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  ))}

  {posts.length === 0 && (
    <p style="color: var(--color-text-secondary); text-align: center; padding: var(--space-8) 0;">No posts yet.</p>
  )}
</Base>

<style>
  .back-btn:hover {
    color: var(--color-text-primary) !important;
  }
  .nav-link {
    position: relative;
    display: inline-block;
    width: fit-content;
    font-weight: 320; /* RAY-412: 330→320 与正文同步 */
    text-decoration: none;
    transition: font-weight 100ms ease-out;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-text-primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms ease-out;
  }
  .nav-link:hover {
    font-weight: 700;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link:not(:hover)::after {
    transform: scaleX(0);
  }
</style>
