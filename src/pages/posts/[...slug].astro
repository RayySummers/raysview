---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL || '/';
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, base }
  }));
}

const { post, base } = Astro.props as { post: any; base: string };
const getHref = (path: string) => base === '/' ? path : `${base}${path}`;
const { Content, headings } = await render(post);

const site = Astro.site ?? new URL('https://raysview.fun');
const rawPath = Astro.url.pathname;
const canonicalUrl = new URL(rawPath.endsWith('/') ? rawPath : `${rawPath}/`, site).toString();
// 摘要：优先 frontmatter excerpt，否则取正文去掉 Markdown 语法后的前 120 字。
// 空字符串 excerpt（excerpt: ""）视为未提供，回退正文摘要。
// 链接/图片语法连同 URL 一起剥离（保留链接文字）；只去掉强调标记与行首列表/标题标记，
// 不再全局删 - _，避免把 og-image 之类的词内连字符破坏掉。
const summary = post.data.excerpt?.trim()
  ? post.data.excerpt
  : (post.body
    ? post.body
        .replace(/```[\s\S]*?```/g, ' ')
        .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
        .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
        .replace(/\*\*([^*]+)\*\*/g, '$1')
        .replace(/__([^_]+)__/g, '$1')
        .replace(/^[#>+\-\s]+/gm, '')
        .replace(/[*_`~]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 120) + '…'
    : undefined);
// banner 可能是绝对 URL 或站内相对路径，统一转成绝对 URL
const bannerUrl = post.data.banner
  ? post.data.banner.startsWith('http')
    ? post.data.banner
    : new URL(post.data.banner, site).toString()
  : undefined;
// og:image 仅在 banner 位于本站时使用；外部图床（如 imgdb）若有防盗链/限流，
// 社交卡片会裂图且无回退 —— 此时省略，由 Base 回退到本地 /og-image.png
const ogCardImage = bannerUrl?.startsWith(site.origin) ? bannerUrl : undefined;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: summary,
  datePublished: post.data.date.toISOString(),
  ...(post.data.modified
    ? { dateModified: post.data.modified.toISOString() }
    : {}),
  author: {
    '@type': 'Person',
    name: 'Rayy Summers',
    url: 'https://raysview.fun/about/'
  },
  publisher: {
    '@type': 'Organization',
    name: '睿见 RayView',
    url: 'https://raysview.fun',
    // Google 富结果要求 publisher.logo 才能入选（含日期/作者头像展示）
    logo: {
      '@type': 'ImageObject',
      url: 'https://raysview.fun/og-image.png'
    }
  },
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  ...(bannerUrl ? { image: bannerUrl } : {})
};
---

<Base
  title={`${post.data.title} - 睿见 RayView`}
  description={summary}
  canonical={canonicalUrl}
  ogType="article"
  ogImage={ogCardImage}
  structuredData={articleLd}
>
  <a href={getHref('/posts/')} class="back-btn" aria-label="Back">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </a>

  {post.data.banner && (
    <img
      src={post.data.banner}
      alt=""
      data-zoomable
      style="width: 100%; height: auto; display: block; margin-bottom: var(--space-5);"
    />
  )}

  <h1 class="post-title" style="font-size: var(--post-title-size); font-weight: 800; letter-spacing: var(--tracking-tight); margin-bottom: var(--space-3); line-height: 1.1; font-family: var(--font-display); font-optical-sizing: auto;">
    {post.data.title}
  </h1>

  <div style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-5);">
    <span>{post.data.date.toISOString().split('T')[0]}</span>
    {post.data.tags && post.data.tags.length > 0 && (
      <span style="margin-left: var(--space-2);">
        {post.data.tags.map((tag: string, i: number) => (
          <>
            {i > 0 && ' '}
            <a href={getHref(`/tags/${tag}`)} style="color: var(--color-text-secondary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--transition-fast);">#{tag}</a>
          </>
        ))}
      </span>
    )}
  </div>

  <div style="max-width: var(--reading-width);">
    <article class="heti" style="font-size: var(--text-lg); line-height: 1.65;">
      <Content />
    </article>
  </div>

  <TableOfContents headings={headings} />

  <div style="display: flex; gap: var(--space-4); margin-top: var(--space-6);">
    <button id="back-btn-bottom" class="back-btn" aria-label="Back to previous page">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </button>
    <button id="scroll-top-btn" class="back-btn" aria-label="Scroll to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>
  </div>
</Base>

<style>
  /* 文章页标题字号：较全局 --text-3xl (48px) 略降 → 40px（页面级 token，仅文章页生效；--text-3xl 保留给 videos 等场景） */
  .post-title {
    --post-title-size: 40px;
  }
  .back-btn {
    display: inline-block;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .back-btn:hover {
    color: var(--color-text-primary) !important;
  }
</style>

<script>
  document.getElementById('back-btn-bottom')?.addEventListener('click', () => {
    history.back();
  });
  document.getElementById('scroll-top-btn')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // 引用资料与脚注：可折叠
  const footnotes = document.querySelector('.footnotes');
  if (footnotes) {
    const heading = footnotes.querySelector('h2');
    heading?.addEventListener('click', () => {
      footnotes.classList.toggle('collapsed');
    });
    // 从正文点击脚注引用时：自动展开 + 目标脚注高亮 3 秒后渐隐
    document.querySelectorAll('a[data-footnote-ref]').forEach(link => {
      link.addEventListener('click', () => {
        footnotes.classList.remove('collapsed');
        const href = link.getAttribute('href');
        if (href) {
          const target = document.querySelector(href);
          if (target) {
            target.classList.remove('fn-flash');
            // 强制 reflow 以重新触发动画
            void target.offsetWidth;
            target.classList.add('fn-flash');
            // 动画结束后移除 class，允许下次重复触发
            setTimeout(() => target.classList.remove('fn-flash'), 3300);
          }
        }
      });
    });
  }
</script>