---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL || '/';
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, base }
  }));
}

const { post, base } = Astro.props as { post: any; base: string };
const getHref = (path: string) => base === '/' ? path : `${base}${path}`;
const { Content, headings } = await render(post);
---

<Base title={`${post.data.title} - RayView`}>
  <a href={getHref('/posts/')} class="back-btn" aria-label="Back">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </a>

  {post.data.banner && (
    <img
      src={post.data.banner}
      alt=""
      data-zoomable
      style="width: 100%; height: auto; display: block; margin-bottom: var(--space-5);"
    />
  )}

  <h1 class="post-title" style="font-size: var(--post-title-size); font-weight: 800; letter-spacing: var(--tracking-tight); margin-bottom: var(--space-3); line-height: 1.1; font-family: var(--font-display); font-optical-sizing: auto;">
    {post.data.title}
  </h1>

  <div style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-5);">
    <span>{post.data.date.toISOString().split('T')[0]}</span>
    {post.data.tags && post.data.tags.length > 0 && (
      <span style="margin-left: var(--space-2);">
        {post.data.tags.map((tag: string, i: number) => (
          <>
            {i > 0 && ' '}
            <a href={getHref(`/tags/${tag}`)} style="color: var(--color-text-secondary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--transition-fast);">#{tag}</a>
          </>
        ))}
      </span>
    )}
  </div>

  <div style="max-width: var(--reading-width);">
    <article class="heti" style="font-size: var(--text-lg); line-height: 1.65;">
      <Content />
    </article>
  </div>

  <TableOfContents headings={headings} />

  <div style="display: flex; gap: var(--space-4); margin-top: var(--space-6);">
    <button id="back-btn-bottom" class="back-btn" aria-label="Back to previous page">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </button>
    <button id="scroll-top-btn" class="back-btn" aria-label="Scroll to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>
  </div>
</Base>

<style>
  /* 文章页标题字号：较全局 --text-3xl (48px) 略降 → 40px（页面级 token，仅文章页生效；--text-3xl 保留给 videos 等场景） */
  .post-title {
    --post-title-size: 40px;
  }
  .back-btn {
    display: inline-block;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .back-btn:hover {
    color: var(--color-text-primary) !important;
  }
</style>

<script>
  document.getElementById('back-btn-bottom')?.addEventListener('click', () => {
    history.back();
  });
  document.getElementById('scroll-top-btn')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // 引用资料与脚注：可折叠
  const footnotes = document.querySelector('.footnotes');
  if (footnotes) {
    const heading = footnotes.querySelector('h2');
    heading?.addEventListener('click', () => {
      footnotes.classList.toggle('collapsed');
    });
    // 从正文点击脚注引用时自动展开，确保跳转目标可见
    document.querySelectorAll('a[data-footnote-ref]').forEach(link => {
      link.addEventListener('click', () => {
        footnotes.classList.remove('collapsed');
      });
    });
  }
</script>