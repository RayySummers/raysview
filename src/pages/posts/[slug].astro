---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const base = import.meta.env.BASE_URL;
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post, base }
  }));
}

const { post, base: siteBase } = Astro.props as { post: any; base: string };
const { Content } = await post.render();
---

<Base title={`${post.data.title} - RayView`}>
  <a href={`${siteBase}/posts/`} class="back-btn" aria-label="Back">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </a>

  {post.data.banner && (
    <img
      src={post.data.banner}
      alt=""
      data-zoomable
      style="width: 100%; max-height: 400px; object-fit: cover; display: block; margin-bottom: var(--space-5);"
    />
  )}

  <h1 style="font-size: var(--text-3xl); font-weight: 800; letter-spacing: var(--tracking-tight); margin-bottom: var(--space-3); line-height: 1.1; font-family: var(--font-display);">
    {post.data.title}
  </h1>

  <div style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-bottom: var(--space-5);">
    <span>{post.data.date.toISOString().split('T')[0]}</span>
    {post.data.tags && post.data.tags.length > 0 && (
      <span style="margin-left: var(--space-2);">
        {post.data.tags.map((tag: string, i: number) => (
          <>
            {i > 0 && ' '}
            <a href={`${siteBase}/tags/${tag}`} style="color: var(--color-text-secondary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--transition-fast);">#{tag}</a>
          </>
        ))}
      </span>
    )}
  </div>

  <div style="max-width: var(--reading-width);">
    <article class="heti" style="font-size: var(--text-lg); line-height: 1.65;">
      <Content />
    </article>
  </div>

  <div style="display: flex; gap: var(--space-4); margin-top: var(--space-6);">
    <button id="back-btn-bottom" class="back-btn" aria-label="Back to previous page">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
    </button>
    <button id="scroll-top-btn" class="back-btn" aria-label="Scroll to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>
  </div>
</Base>

<style>
  .back-btn {
    display: inline-block;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .back-btn:hover {
    color: var(--color-text-primary) !important;
  }
</style>

<script>
  document.getElementById('back-btn-bottom')?.addEventListener('click', () => {
    history.back();
  });
  document.getElementById('scroll-top-btn')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>