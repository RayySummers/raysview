---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const siteBase = import.meta.env.BASE_URL;
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter(post => post.data.tags?.includes('biweekly'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="半月记 Biweekly - RayView">
  <a href={`${siteBase}/posts/`} style="display: inline-block; color: var(--color-text-secondary); transition: color var(--transition-fast);" aria-label="Back" class="back-btn">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
  </a>

  <h1 style="font-size: var(--text-2xl); font-weight: 800; letter-spacing: var(--tracking-tight); margin-bottom: var(--space-2); line-height: 1.1; font-family: var(--font-display); font-optical-sizing: auto;">
    半月记 / Biweekly
  </h1>
  <p style="font-size: var(--text-sm); color: var(--color-text-secondary); margin-bottom: var(--space-6);">
    系列文章
  </p>

  <div>
    {posts.map((post) => (
      <article style="margin-bottom: var(--space-4);">
        {post.data.banner && (
          <a href={`${siteBase}/posts/${post.id}`} style="display: inline-block; margin-bottom: var(--space-2); overflow: hidden;">
            <img
              src={post.data.banner}
              alt=""
              style="width: 100%; max-height: 300px; object-fit: contain; display: block;"
              data-zoomable
            />
          </a>
        )}
        <a href={`${siteBase}/posts/${post.id}`} style="display: block; text-decoration: none;">
          <h2 style="font-size: var(--text-base); font-weight: 400; color: var(--color-text-primary); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--transition-fast);">
            {post.data.title}
          </h2>
        </a>
        <div style="font-size: var(--text-xs); color: var(--color-text-secondary); margin-top: var(--space-1);">
          <span>{post.data.date.toISOString().split('T')[0]}</span>
        </div>
      </article>
    ))}
  </div>

  {posts.length === 0 && (
    <p style="color: var(--color-text-secondary); text-align: center; padding: var(--space-8) 0;">Biweekly 系列文章陆续更新中。</p>
  )}
</Base>

<style>
  .back-btn:hover {
    color: var(--color-text-primary) !important;
  }
</style>