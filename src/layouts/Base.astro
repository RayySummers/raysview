---
import '../styles/global.css';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/inter';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import mediumZoom from 'medium-zoom';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'RayView Blog' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh" data-base={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Iosevka:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&family=Sarasa+Mono+SC&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/heti/umd/heti.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/heti/umd/heti-addon.min.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const lenis = new Lenis({
          duration: 0.1,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true
        });
        // Expose lenis globally for ToC scroll
        window.lenis = lenis;
        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        if (document.querySelector('.heti')) {
          const heti = new Heti('.heti');
          heti.autoSpacing();
        }

        mediumZoom('[data-zoomable]', {
          margin: 24,
          background: 'rgba(0,0,0,0.85)'
        });

        // Add zoomable to images in articles
        document.querySelectorAll('article.heti img').forEach(img => {
          img.setAttribute('data-zoomable', '');
        });
      });
    </script>
  </head>
  <body>
    <Header />
    <main style={`padding-left: var(--padding-x); padding-right: var(--padding-x); padding-top: var(--space-6); padding-bottom: var(--space-6); max-width: var(--max-width); margin: 0 auto; width: 100%;`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>