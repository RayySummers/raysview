---
import '../styles/global.css';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/roboto-flex/opsz.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** 页面规范 URL（绝对地址）；缺省时由当前页面路径 + site 推导 */
  canonical?: string;
  /** Open Graph type，默认 website（文章页 article / 关于页 profile） */
  ogType?: string;
  /** og:image 绝对 URL；缺省用站点 Logo PNG（public/og-image.png，社交平台不支持 SVG 卡片图） */
  ogImage?: string;
  /** 页面级 JSON-LD 结构化数据（一个对象或对象数组，会自动转义） */
  structuredData?: object | object[];
  /** 禁止搜索引擎索引（如 404 页） */
  noindex?: boolean;
}

const {
  title,
  description = '睿见 RayView 是 Rayy Summers 的个人博客，分享设计、语言学、AI、社会现象与日常观察。',
  canonical,
  ogType = 'website',
  ogImage,
  structuredData,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL || '/';
const site = Astro.site ?? new URL('https://raysview.fun');
// canonical 缺省推导：site + 当前路径（补尾斜杠，与站点实际生成的目录 URL 一致）
const rawPath = Astro.url.pathname;
const canonicalUrl =
  canonical ??
  new URL(rawPath.endsWith('/') ? rawPath : `${rawPath}/`, site).toString();
const siteName = '睿见 RayView';
// 社交分享卡片不支持 SVG：用 /og-image.png（由 RayView_transparent.svg 栅格化而来，1200×630）
const ogImageUrl = ogImage ?? new URL('/og-image.png', site).toString();
const ldBlocks = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
// JSON-LD 转义：把 < 序列化为 \u003c，防止 </script> 提前闭合破坏页面
const jsonLd = JSON.stringify(ldBlocks).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh" data-base={base}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="zh_CN" />
    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ldBlocks.length > 0 && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" type="image/png" sizes="64x64" href={base === '/' ? '/favicon.png' : `${base}/favicon.png`} />
    <link rel="preload" href="/fonts/MiSans-VF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/heti/umd/heti.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/heti/umd/heti-addon.min.js"></script>
    <script is:inline>
      // Copy button for code blocks - runs immediately
      function initCopyButtons() {
        document.querySelectorAll('article.heti pre').forEach(pre => {
          if (pre.querySelector('.copy-btn')) return;
          const btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
          btn.title = 'Copy code';
          pre.style.position = 'relative';
          pre.style.paddingRight = '40px';
          pre.appendChild(btn);
          btn.addEventListener('click', () => {
            const code = pre.querySelector('code');
            if (code) {
              navigator.clipboard.writeText(code.textContent || '').then(() => {
                btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>';
                setTimeout(() => {
                  btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
                }, 1500);
              });
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCopyButtons);
      } else {
        initCopyButtons();
      }

      // Lenis smooth scroll - needs DOMContentLoaded
      document.addEventListener('DOMContentLoaded', () => {
        try {
          const lenis = new Lenis({ duration: 0.1, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smoothWheel: true });
          window.lenis = lenis;
          function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
          requestAnimationFrame(raf);
        } catch (e) {}

        if (document.querySelector('.heti')) {
          const heti = new Heti('.heti');
          heti.autoSpacing();
        }

        document.querySelectorAll('article.heti img').forEach(img => img.setAttribute('data-zoomable', ''));
      });
    </script>

    <script is:inline>
      // 图片灯箱：点击 [data-zoomable] 全屏放大；滚轮 / 捏合自由缩放（可超过原始尺寸）、
      // 拖动平移；右上角 ✕ / ESC / 点击遮罩关闭。桌面端（Pointer Events）与移动端（触摸）统一处理。
      (function () {
        var overlay = null;      // 遮罩元素
        var boxImg = null;       // 灯箱内 <img>
        var origImg = null;      // 被点击的原图
        var scale = 1, minScale = 1, tx = 0, ty = 0;
        var pointers = {};       // pointerId -> {x, y}
        var lastPos = null;      // 单指拖动基准点
        var pinch = null;        // 双指捏合基准 {dist, scale, mid}
        var animating = false;   // 打开动画期间忽略手势
        var MAX_SCALE = 8;
        var PAD = 24;            // 灯箱内边距
        var PAN_MARGIN = 80;     // 平移允许超出视口边界的量（px）

        function clamp(v, lo, hi) { return Math.min(hi, Math.max(lo, v)); }

        function apply() {
          boxImg.style.transform = 'translate3d(' + tx + 'px,' + ty + 'px,0) scale(' + scale + ')';
        }

        function naturalSize() {
          var w = origImg.naturalWidth, h = origImg.naturalHeight;
          if (!w || !h) {
            var r = origImg.getBoundingClientRect();
            w = r.width || window.innerWidth;
            h = r.height || window.innerHeight;
          }
          return { w: w, h: h };
        }

        function fitScale() {
          var n = naturalSize();
          return Math.min((window.innerWidth - PAD * 2) / n.w, (window.innerHeight - PAD * 2) / n.h, 1);
        }

        // 原图在页面上的矩形 → 灯箱图片所需的变换（scale + 相对视口中心的偏移）：
        // 等比显示的图按尺寸比例映射；object-fit: cover 裁剪图（栏目卡片）按 cover 比例
        // 缩放并把自然中心对齐裁框中心（与默认 object-position: 50% 50% 的裁切内容完全重合），
        // 两种情况下灯箱图片都能在矩形内与页面原图内容对齐，实现「原位打开 / 原位退回」。
        function originTransform(rect) {
          if (!rect || rect.width <= 0 || rect.height <= 0) return null;
          var n = naturalSize();
          if (!n.w || !n.h) return null;
          return {
            s: Math.max(rect.width / n.w, rect.height / n.h),
            x: rect.left + rect.width / 2 - window.innerWidth / 2,
            y: rect.top + rect.height / 2 - window.innerHeight / 2
          };
        }

        function panBounds() {
          var n = naturalSize();
          var dispW = n.w * scale, dispH = n.h * scale;
          var vw = window.innerWidth, vh = window.innerHeight;
          return {
            x: Math.max(0, (dispW - vw) / 2 + PAN_MARGIN),
            y: Math.max(0, (dispH - vh) / 2 + PAN_MARGIN)
          };
        }

        function clampPan() {
          var b = panBounds();
          tx = clamp(tx, -b.x, b.x);
          ty = clamp(ty, -b.y, b.y);
        }

        // 以视口内某点为中心缩放（滚轮 / 捏合 / 双击放大共用）
        function zoomAt(cx, cy, newScale) {
          var vw = window.innerWidth, vh = window.innerHeight;
          var lx = (cx - vw / 2 - tx) / scale;
          var ly = (cy - vh / 2 - ty) / scale;
          scale = clamp(newScale, minScale, MAX_SCALE);
          tx = cx - vw / 2 - lx * scale;
          ty = cy - vh / 2 - ly * scale;
          clampPan();
          apply();
        }

        function panBy(dx, dy) {
          tx += dx;
          ty += dy;
          clampPan();
          apply();
        }

        function isOpen() { return !!overlay; }

        function pointerDist() {
          var pts = [];
          for (var id in pointers) pts.push(pointers[id]);
          if (pts.length < 2) return 0;
          return Math.sqrt(Math.pow(pts[0].x - pts[1].x, 2) + Math.pow(pts[0].y - pts[1].y, 2));
        }

        function pointerMid() {
          var pts = [];
          for (var id in pointers) pts.push(pointers[id]);
          return { x: (pts[0].x + pts[1].x) / 2, y: (pts[0].y + pts[1].y) / 2 };
        }

        function open(img) {
          if (isOpen()) return;
          origImg = img;

          overlay = document.createElement('div');
          overlay.className = 'ray-lightbox';
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-modal', 'true');
          overlay.setAttribute('aria-label', '图片预览');

          boxImg = document.createElement('img');
          boxImg.src = img.src;
          boxImg.alt = img.alt || '';
          boxImg.draggable = false;
          boxImg.className = 'ray-lightbox__img';

          var closeBtn = document.createElement('button');
          closeBtn.type = 'button';
          closeBtn.className = 'ray-lightbox__close';
          closeBtn.setAttribute('aria-label', '关闭');
          closeBtn.textContent = '\u2715'; // ✕

          overlay.appendChild(boxImg);
          overlay.appendChild(closeBtn);
          document.body.appendChild(overlay);

          scale = minScale = fitScale();
          tx = 0; ty = 0;

          // 打开动画：从原图所在位置平滑放大到居中（等比图与 cover 裁剪图均原位打开）
          var t0 = originTransform(img.getBoundingClientRect());
          if (t0) {
            boxImg.style.transition = 'none';
            boxImg.style.transform = 'translate3d(' + t0.x + 'px,' + t0.y + 'px,0) scale(' + t0.s + ')';
          }
          overlay.style.opacity = '0';
          void overlay.offsetWidth; // reflow，触发过渡
          boxImg.style.transition = 'transform 0.28s cubic-bezier(0.22,1,0.36,1), opacity 0.28s ease';
          overlay.style.opacity = '1';
          apply();

          // 锁背景滚动（Lenis + 原生双保险）
          document.body.style.overflow = 'hidden';
          if (window.lenis && window.lenis.stop) window.lenis.stop();

          closeBtn.focus();
          animating = true;
          setTimeout(function () {
            animating = false;
            boxImg.style.transition = 'none';
          }, 320);

          // 原图懒加载未完成时，初始尺寸按布局兜底；加载完成后校正适配比例
          boxImg.addEventListener('load', function () {
            if (!isOpen()) return;
            var nw = boxImg.naturalWidth, nh = boxImg.naturalHeight;
            if (!nw || !nh || (origImg.naturalWidth && origImg.naturalHeight)) return;
            var newMin = Math.min((window.innerWidth - PAD * 2) / nw, (window.innerHeight - PAD * 2) / nh, 1);
            if (scale <= minScale + 0.001) {
              minScale = newMin;
              scale = newMin;
              tx = 0; ty = 0;
              apply();
            } else {
              minScale = newMin;
            }
          });

          // ---- 元素级事件：在 open() 内挂载（元素每次重建，随 close() 移除）----

          // 遮罩点击（overlay 自身，即图片外区域）关闭；✕ 按钮与图片上的点击不受影响
          overlay.addEventListener('click', function (e) {
            if (e.target === overlay) close();
          });

          // 滚轮缩放（整层响应，含图片外区域）
          overlay.addEventListener('wheel', function (e) {
            if (animating) return;
            e.preventDefault();
            var dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * 100 : e.deltaY;
            zoomAt(e.clientX, e.clientY, scale * Math.exp(-dy * 0.0022));
          }, { passive: false });

          // 指针：单指/单键拖动平移，双指捏合缩放
          boxImg.addEventListener('pointerdown', function (e) {
            if (animating) return;
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            boxImg.setPointerCapture(e.pointerId);
            pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
            if (Object.keys(pointers).length === 1) {
              lastPos = { x: e.clientX, y: e.clientY };
              pinch = null;
            } else if (Object.keys(pointers).length === 2) {
              pinch = { dist: pointerDist(), scale: scale };
              lastPos = null;
            }
            e.preventDefault();
          });

          boxImg.addEventListener('pointermove', function (e) {
            if (!pointers[e.pointerId]) return;
            pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
            if (Object.keys(pointers).length === 1) {
              if (lastPos) panBy(e.clientX - lastPos.x, e.clientY - lastPos.y);
              lastPos = { x: e.clientX, y: e.clientY };
            } else if (Object.keys(pointers).length === 2 && pinch) {
              var mid = pointerMid();
              zoomAt(mid.x, mid.y, pinch.scale * (pointerDist() / pinch.dist));
              if (pinch.mid) panBy(mid.x - pinch.mid.x, mid.y - pinch.mid.y);
              pinch.mid = mid;
            }
          });

          function pointerEnd(e) {
            delete pointers[e.pointerId];
            var count = Object.keys(pointers).length;
            if (count === 1) {
              for (var id in pointers) lastPos = { x: pointers[id].x, y: pointers[id].y };
              pinch = null;
            } else if (count === 0) {
              lastPos = null;
              pinch = null;
            }
          }
          boxImg.addEventListener('pointerup', pointerEnd);
          boxImg.addEventListener('pointercancel', pointerEnd);
          boxImg.addEventListener('lostpointercapture', pointerEnd);

          // 双击 / 双触：在缩放与复位间切换
          boxImg.addEventListener('dblclick', function (e) {
            if (animating) return;
            if (scale > minScale + 0.01) {
              scale = minScale; tx = 0; ty = 0;
              boxImg.style.transition = 'transform 0.25s ease';
              apply();
              setTimeout(function () { boxImg.style.transition = 'none'; }, 260);
            } else {
              zoomAt(e.clientX, e.clientY, Math.min(minScale * 2.5, MAX_SCALE));
            }
          });

          // ✕ 关闭按钮
          closeBtn.addEventListener('click', close);
        }

        function close() {
          if (!isOpen()) return;
          var o = overlay;
          var img = boxImg;
          var src = origImg;
          overlay = null;
          pointers = {};
          lastPos = null;
          pinch = null;
          animating = true; // 关闭动画期间忽略手势
          document.body.style.overflow = '';
          if (window.lenis && window.lenis.start) window.lenis.start();

          // 原位退回：从当前位置平滑缩回原图所在位置/尺寸，同时淡出
          var t = originTransform(src.getBoundingClientRect());
          if (t) {
            img.style.transition = 'transform 0.25s cubic-bezier(0.4,0,0.2,1), opacity 0.25s ease';
            img.style.transform = 'translate3d(' + t.x + 'px,' + t.y + 'px,0) scale(' + t.s + ')';
          } else {
            img.style.transition = 'opacity 0.2s ease';
          }
          img.style.opacity = '0';
          o.style.opacity = '0';
          setTimeout(function () {
            o.remove();
            animating = false;
          }, t ? 270 : 220);
        }

        // ---- 打开：委托点击（不随 DOM 就绪顺序变化）----
        document.addEventListener('click', function (e) {
          if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
          var t = e.target;
          if (!t || t.tagName !== 'IMG' || !t.closest('[data-zoomable]')) return;
          e.preventDefault(); // 列表卡片图被 <a> 包裹：阻止跳转，只开灯箱
          open(t);
        });

        // ---- 关闭：ESC ----
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && isOpen()) close();
        });
      })();
    </script>
  </head>
  <body>
    <Header />
    <main style={`padding-left: var(--padding-x); padding-right: var(--padding-x); padding-top: var(--space-6); padding-bottom: var(--space-6); max-width: var(--max-width); margin: 0 auto; width: 100%;`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>